# Production frontend env.
#
# NEXT_PUBLIC_API_URL is inlined at BUILD time (`next build`), not read at
# runtime. deploy/deploy.sh passes it from PUBLIC_ORIGIN in /etc/aylamusk.env,
# so changing your domain means re-running deploy/deploy.sh (a rebuild).
#
# Point it at the site's public origin (nginx routes /api to the backend).
NEXT_PUBLIC_API_URL=https://your-domain.com
