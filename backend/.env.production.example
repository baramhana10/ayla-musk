# Production backend env — on the VPS these values come from /etc/aylamusk.env
# via pm2 (see deploy/ecosystem.config.js), so you normally do NOT create a
# backend/.env file in production. This file documents what must be set.

DATABASE_URL="file:./prisma/prod.db"
JWT_SECRET="generate-with: openssl rand -hex 48"
PORT=4000
# Public origin browsers load the site from — used for CORS. No trailing slash.
CLIENT_ORIGIN="https://your-domain.com"
NODE_ENV="production"

# Consumed only by `npm run seed`:
ADMIN_EMAIL="admin@aylamusk.com"
ADMIN_PASSWORD="change-me"

# Cloudinary — product/category image uploads. The admin browser uploads files
# straight to Cloudinary; the backend only signs the request with the secret
# below (it never reaches the client). Get these from your Cloudinary dashboard.
# Leave blank to disable uploads (the admin uploader will report "not configured").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="aylamusk"
